# Copy to .env and adjust for local development:
#   cp .env.example .env
#
# Environment variables override values in .env when both are set.

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# console (human-readable) or json (one JSON object per line for production)
LOG_FORMAT=console

# WebSocket session
RECONNECT_WINDOW_S=30
# Close connection when no inbound WS message for this many seconds (P2-001)
HEARTBEAT_IDLE_TIMEOUT_S=45
AUDIO_BUFFER_SECONDS=30
# Max buffer.overflow + BUFFER_OVERFLOW notification pairs per second per session (P2-004)
BUFFER_OVERFLOW_NOTIFY_MAX_PER_SECOND=10
# Hold out-of-order audio frames up to this many ms before gap detection (P2-003)
AUDIO_REORDER_BUFFER_MS=100

# VAD (silero | mock)
VAD_BACKEND=silero
VAD_SPEECH_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=500
VAD_SPEECH_PAD_MS=300

# ASR (faster_whisper | mock | remote)
# AI Gateway (Phase 8): python -m app.ai_gateway.main
# AI_GATEWAY_PORT=8080
# AI_GATEWAY_REGISTRY_PATH=app/ai_gateway/default_registry.yaml
# AI_GATEWAY_UPSTREAM_TIMEOUT_S=120
# AI_GATEWAY_HEALTH_CHECKS_ENABLED=true
# AI_GATEWAY_HEALTH_CHECK_INTERVAL_S=30
# AI_GATEWAY_HEALTH_CHECK_TIMEOUT_S=5

ASR_BACKEND=faster_whisper
# EKS (P8-006): remote ASR via AI Gateway — not direct asr-service
# ASR_BACKEND=remote
# ASR_REMOTE_BASE_URL=http://ai-gateway:8080
# ASR_REMOTE_VIA_AI_GATEWAY=true
# ASR_CAPABILITY=asr.default
# Direct asr-service (local gateway dev without gateway flag):
# ASR_REMOTE_BASE_URL=http://asr-service:8081
# faster-whisper model id, e.g. tiny, base, small, large-v3-turbo
ASR_MODEL=large-v3-turbo
# ASR_DEVICE=cpu
# ASR_COMPUTE_TYPE=int8
# GPU image (docker/asr-inference): ASR_DEVICE=cuda ASR_COMPUTE_TYPE=float16
ASR_PARTIAL_INTERVAL_MS=300
